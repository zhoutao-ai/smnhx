# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 本地测试 Mock AI（不需要任何 API Key）───
# MOCK_AI=true

# ─── 支付宝当面付 ───────────────────────

# 沙箱环境（开发测试用）
# 1. 打开 https://openhome.alipaydev.com/develop/sandbox/app
# 2. 查看沙箱应用 → 获取 APPID、应用私钥、支付宝公钥
# 3. 使用沙箱买家账号 + 沙箱钱包 APP 测试支付
# ALIPAY_SANDBOX=true
# ALIPAY_APP_ID=2025xxxxxxxxxxxx
# ALIPAY_PRIVATE_KEY=MIIEvgIBADANBgkqhkiG9w0B...
# ALIPAY_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0B...
# ALIPAY_KEY_TYPE=PKCS1
# NEXT_PUBLIC_ALIPAY_SANDBOX=true

# 生产环境（上线时启用，需替换为正式应用凭证）
# ALIPAY_SANDBOX=false
# ALIPAY_APP_ID=2021xxxxxxxxxxxx
# ALIPAY_PRIVATE_KEY=MIIEvgIBADANBgkqhkiG9w0B...
# ALIPAY_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0B...
# ALIPAY_KEY_TYPE=PKCS1
# NEXT_PUBLIC_ALIPAY_SANDBOX=false

# 个人收款码（无商家 API 时的备选方案）
# NEXT_PUBLIC_ALIPAY_URL=https://qr.alipay.com/tsx01234567...

# Mock 模式（跳过真实支付）
# MOCK_PAY=true

# ─── 支付功能开关（true=启用, false=隐藏所有支付入口）───
# NEXT_PUBLIC_ENABLE_PAY=true

# ─── 后台管理密码 ───────────────────────
# ADMIN_TOKEN=your-secure-admin-password

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
