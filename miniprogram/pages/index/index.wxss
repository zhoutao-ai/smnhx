.index-page {
  padding-top: 56rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 36rpx;
}

.eyebrow {
  color: #9b6c24;
  font-size: 24rpx;
  letter-spacing: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  line-height: 1.6;
}

.form-panel {
  padding: 32rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  margin-bottom: 14rpx;
  color: #6d5d49;
  font-size: 24rpx;
}

.input,
.picker {
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #fffaf0;
  border: 1rpx solid rgba(142, 105, 43, 0.22);
  color: #261c13;
  font-size: 28rpx;
  line-height: 84rpx;
}

.picker-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.field:nth-of-type(3) .picker-row {
  grid-template-columns: repeat(2, 1fr);
}

.hint {
  display: block;
  margin-top: 12rpx;
  color: #9b6c24;
  font-size: 24rpx;
}

.gender-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.gender {
  min-height: 84rpx;
  border-radius: 14rpx;
  background: #fffaf0;
  color: #7d7162;
  border: 1rpx solid rgba(142, 105, 43, 0.22);
  font-size: 28rpx;
  line-height: 84rpx;
}

.gender.active {
  color: #8f5d18;
  background: rgba(200, 135, 44, 0.12);
  border-color: rgba(143, 93, 24, 0.55);
}

.submit {
  margin-top: 16rpx;
}
